# Set default behaviour to automatically normalize line endings.
* text=auto

# Explicitly declare text files you want to always have LF line endings on checkout.
*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ino text eol=lf
*.md text eol=lf
