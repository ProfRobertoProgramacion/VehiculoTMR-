<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tmr_bringup</name>
  <version>1.0.0</version>
  <description>Archivos de configuración y lanzamiento (launch) para el vehículo autónomo TMR</description>
  <maintainer email="rober@todo.todo">rober</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>tmr_camera</exec_depend>
  <exec_depend>tmr_vision</exec_depend>
  <exec_depend>tmr_control</exec_depend>
  <exec_depend>tmr_hardware</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
